#!/bin/bash
# List clients reported by a Starlink router's read-only gRPC status API.
set -euo pipefail

VERSION="0.0.2"
router="${STARLINK_ROUTER:-192.168.1.1:9000}"
sort_by="hostname"
json_output=false

die() {
    printf 'starlink: %s\n' "$*" >&2
    exit 1
}

usage() {
    cat <<'EOF'
Usage: starlink [options]

List Starlink router clients with hostname, IP address, and MAC address.

Options:
  -s, --sort hostname|ip   Sort clients (default: hostname)
      --router HOST:PORT  Router gRPC endpoint (default: 192.168.1.1:9000)
      --json              Print a sorted JSON array of hostname/ip/mac objects
  -h, --help              Show this help
  -V, --version           Show the version

STARLINK_ROUTER sets the default endpoint. --router takes precedence.
EOF
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -s|--sort|--router)
            [[ $# -ge 2 && -n "$2" ]] || die "$1 requires a value."
            if [[ "$1" == "--router" ]]; then
                router="$2"
            else
                sort_by=$(printf '%s' "$2" | LC_ALL=C tr '[:upper:]' '[:lower:]')
            fi
            shift 2
            ;;
        --json) json_output=true; shift ;;
        -h|--help) usage; exit 0 ;;
        -V|--version) printf 'starlink %s\n' "$VERSION"; exit 0 ;;
        *) die "Unknown option: $1. Use --help for usage." ;;
    esac
done

[[ "$sort_by" == "hostname" || "$sort_by" == "ip" ]] || die "Sort must be hostname or ip."
if [[ "$router" =~ ^([A-Za-z0-9][A-Za-z0-9._-]*|\[[0-9A-Fa-f:.]+\]):([0-9]+)$ ]]; then
    port="${BASH_REMATCH[2]}"
    if [[ ${#port} -gt 5 ]] || (( 10#$port < 1 || 10#$port > 65535 )); then
        die "Router port must be between 1 and 65535."
    fi
else
    die "Router must be HOST:PORT or [IPv6]:PORT."
fi

for dependency in grpcurl jq; do
    command -v "$dependency" >/dev/null 2>&1 || die "Missing dependency: $dependency. Reinstall starlink with Homebrew or APT; see the README."
done

if ! response=$(grpcurl -plaintext -max-time 10 -d '{"getStatus":{}}' \
        "$router" SpaceX.API.Device.Device/Handle 2>/dev/null); then
    die "Cannot query router at $router. Check the address, local connection, and router API support."
fi

if ! clients=$(printf '%s' "$response" | jq -sce --arg sort "$sort_by" '
    if length != 1 then error("Expected one status response") else .[0] end
    | if type != "object" or (.wifiGetStatus | type) != "object" then
        error("Expected Starlink router WiFi status")
    else .wifiGetStatus end
    | .clients | if . == null then [] else . end
    | if type != "array" or any(.[]; type != "object") then
        error("Expected a clients array")
    else . end
    | map(
        if any([.name, .ipAddress, .macAddress][]; . != null and type != "string") then
            error("Expected string client fields")
        else {
            hostname: (.name // "" | if . == "" then "(Unknown)" else . end),
            ip: (.ipAddress // "" | if . == "" then "(No IP)" else . end),
            mac: (.macAddress // "" | if . == "" then "(No MAC)" else . end)
        } end)
    | sort_by(if $sort == "ip" then
        .ip as $ip | ($ip | split(".")) as $parts
        | if ($ip | test("^([0-9]{1,3}\\.){3}[0-9]{1,3}$"))
                and all($parts[]; tonumber <= 255) then
            [0] + ($parts | map(tonumber))
        else [1, ($ip | ascii_downcase)] end
    else [(.hostname | ascii_downcase), .ip] end)
'); then
    die "Invalid or unsupported router response; expected wifiGetStatus clients."
fi

if "$json_output"; then
    printf '%s\n' "$clients" | jq .
    exit 0
fi

count=$(printf '%s' "$clients" | jq length)
printf 'Starlink router (%s)\nClients: %s | Sorted by: %s\n\n' "$router" "$count" "$sort_by"
printf '%-30s | %-15s | %-17s\n' 'Hostname' 'IP Address' 'MAC Address'
printf '%s\n' '-------------------------------+-----------------+------------------'
rows=$(printf '%s' "$clients" | jq -r '.[] | [.hostname, .ip, .mac]
    | map(gsub("[\u0000-\u001f\u007f-\u009f]"; "?")) | join("\t")')
if [[ -n "$rows" ]]; then
    while IFS=$'\t' read -r hostname ip mac; do
        printf '%-30s | %-15s | %-17s\n' "$hostname" "$ip" "$mac"
    done <<< "$rows"
fi
